<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Lanzador.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Lanzador">
    <Grid Background="{ThemeResource FondoVentanaBrush}">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///Acento.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera: marca, nombre, lema y la única acción global -->
        <Grid Grid.Row="0" Padding="32,24,32,16" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="48" Height="48" VerticalAlignment="Center">
                <Ellipse Fill="{ThemeResource AcentoBrush}" />
                <Path Data="M16.1,31.9 L31.9,16.1 M20.6,16.1 H31.9 V27.4" Stroke="{ThemeResource AcentoTextoBrush}" StrokeThickness="4.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Lanzador" FontFamily="{StaticResource FuenteTitulo}" FontSize="32" FontWeight="SemiBold" LineHeight="36" />
                <TextBlock Text="Las herramientas, listas" FontFamily="{StaticResource FuenteTitulo}" FontSize="16" Style="{StaticResource TextoAcento}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <!-- Recuento discreto («2 actualizaciones») solo cuando hay más de una herramienta con versión nueva -->
                <TextBlock x:Name="TextoRecuento" Visibility="Collapsed" Style="{StaticResource TextoAcento}" VerticalAlignment="Center" />
                <Button x:Name="BotonRefrescar" Content="Buscar actualizaciones" Click="OnRefrescarClick" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Avisos: franja discreta de «Lanzador X disponible», errores de la ventana y «hay actualizaciones» al abrir o al buscar -->
        <StackPanel Grid.Row="1" Spacing="8" Margin="32,0,32,8">
            <Border x:Name="FranjaLanzador" Visibility="Collapsed" Background="{ThemeResource AcentoSuaveBrush}" CornerRadius="8" Padding="16,6">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TextoFranja" Style="{StaticResource TextoAcento}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <HyperlinkButton x:Name="EnlaceNovedades" Grid.Column="1" Content="Ver novedades" VerticalAlignment="Center" />
                    <HyperlinkButton Grid.Column="2" Content="Más tarde" Click="OnMasTardeClick" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <!-- Sin red con herramientas instaladas: las tarjetas salen del disco (solo Abrir y Quitar) y esta franja lo dice -->
            <InfoBar x:Name="AvisoSinConexion" IsOpen="False" IsClosable="False" Severity="Warning" Title="Sin conexión" />
            <InfoBar x:Name="AvisoIndice" IsOpen="False" IsClosable="True" Severity="Error" />
            <InfoBar x:Name="AvisoActualizaciones" IsOpen="False" IsClosable="True" Severity="Informational" Title="Actualizaciones" />
        </StackPanel>

        <!-- Lista de tarjetas con desplazamiento -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="32,8,32,8">
            <StackPanel x:Name="ListaTarjetas" Spacing="16" Margin="0,0,0,24" />
        </ScrollViewer>

        <!-- Estado vacío: el catálogo aún no trae herramientas -->
        <StackPanel Grid.Row="2" x:Name="EstadoVacio" Visibility="Collapsed" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
            <Grid Width="96" Height="96" Margin="0,0,0,8">
                <Ellipse Stroke="{ThemeResource AcentoBrush}" StrokeThickness="4" Opacity="0.45" Margin="2" />
                <Path Data="M32.3,63.8 L63.8,32.3 M41.3,32.3 H63.8 V54.8" Stroke="{ThemeResource AcentoBrush}" StrokeThickness="8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Grid>
            <TextBlock Text="Todavía no hay herramientas en el catálogo" FontFamily="{StaticResource FuenteTitulo}" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="Cuando se publiquen, aparecerán aquí listas para instalar. Pulsa «Buscar actualizaciones» para volver a mirar." Style="{StaticResource TextoSecundario}" TextAlignment="Center" />
        </StackPanel>

        <!-- Estado de fallo: el catálogo no se pudo leer o su firma no es válida; dice por qué y qué hacer, nunca una lista vacía en silencio -->
        <StackPanel Grid.Row="2" x:Name="EstadoCatalogo" Visibility="Collapsed" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
            <Grid Width="96" Height="96" Margin="0,0,0,8">
                <Ellipse Stroke="{ThemeResource AcentoBrush}" StrokeThickness="4" Opacity="0.45" Margin="2" />
                <FontIcon Glyph="&#xE7BA;" FontSize="40" Foreground="{ThemeResource AcentoBrush}" />
            </Grid>
            <TextBlock x:Name="TituloEstadoCatalogo" Text="No se pudo leer el catálogo" FontFamily="{StaticResource FuenteTitulo}" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock x:Name="TextoEstadoCatalogo" Style="{StaticResource TextoSecundario}" TextAlignment="Center" />
            <Button x:Name="BotonReintentar" Content="Volver a intentar" Click="OnRefrescarClick" HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Pie: espacio total y Abrir carpeta -->
        <Grid Grid.Row="3" Padding="32,16" ColumnSpacing="16" BorderBrush="{ThemeResource TarjetaBordeBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TextoEspacioTotal" Text="Espacio total en %LOCALAPPDATA%\Dathinel: 0 B" Style="{StaticResource TextoSecundario}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <HyperlinkButton Content="Acerca de" Click="OnAcercaDeClick" VerticalAlignment="Center" />
                <Button Content="Abrir carpeta" Click="OnAbrirCarpetaClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
