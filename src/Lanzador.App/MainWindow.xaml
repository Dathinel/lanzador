<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Lanzador.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Lanzador">
    <Grid Background="{ThemeResource FondoVentanaBrush}">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///Acento.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera: marca, nombre, lema y la única acción global -->
        <Grid Grid.Row="0" Padding="32,24,32,16" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="48" Height="48" VerticalAlignment="Center">
                <Ellipse Fill="{ThemeResource AcentoBrush}" />
                <Path Data="M16.1,31.9 L31.9,16.1 M20.6,16.1 H31.9 V27.4" Stroke="{ThemeResource AcentoTextoBrush}" StrokeThickness="4.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Lanzador" FontFamily="{StaticResource FuenteTitulo}" FontSize="32" FontWeight="SemiBold" LineHeight="36" />
                <TextBlock Text="Las herramientas, listas" FontFamily="{StaticResource FuenteTitulo}" FontSize="16" Style="{StaticResource TextoAcento}" />
            </StackPanel>
            <Button Grid.Column="2" x:Name="BotonRefrescar" Content="Actualizar catálogo" Click="OnRefrescarClick" VerticalAlignment="Center" />
        </Grid>

        <!-- Aviso si no se puede verificar el índice -->
        <InfoBar Grid.Row="1" x:Name="AvisoIndice" IsOpen="False" IsClosable="True" Severity="Error" Margin="32,0,32,8" />

        <!-- Lista de tarjetas con desplazamiento -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="32,8,32,8">
            <StackPanel x:Name="ListaTarjetas" Spacing="16" Margin="0,0,0,24" />
        </ScrollViewer>

        <!-- Estado vacío: el catálogo aún no trae herramientas -->
        <StackPanel Grid.Row="2" x:Name="EstadoVacio" Visibility="Collapsed" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
            <Grid Width="96" Height="96" Margin="0,0,0,8">
                <Ellipse Stroke="{ThemeResource AcentoBrush}" StrokeThickness="4" Opacity="0.45" Margin="2" />
                <Path Data="M32.3,63.8 L63.8,32.3 M41.3,32.3 H63.8 V54.8" Stroke="{ThemeResource AcentoBrush}" StrokeThickness="8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Grid>
            <TextBlock Text="Todavía no hay herramientas en el catálogo" FontFamily="{StaticResource FuenteTitulo}" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="Cuando se publiquen, aparecerán aquí listas para instalar. Pulsa «Actualizar catálogo» para volver a mirar." Style="{StaticResource TextoSecundario}" TextAlignment="Center" />
        </StackPanel>

        <!-- Pie: espacio total y Abrir carpeta -->
        <Grid Grid.Row="3" Padding="32,16" ColumnSpacing="16" BorderBrush="{ThemeResource TarjetaBordeBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TextoEspacioTotal" Text="Espacio total en %LOCALAPPDATA%\Dathinel: 0 B" Style="{StaticResource TextoSecundario}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <HyperlinkButton Content="Acerca de" Click="OnAcercaDeClick" VerticalAlignment="Center" />
                <Button Content="Abrir carpeta" Click="OnAbrirCarpetaClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
